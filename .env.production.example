# Real production secrets, read by .kamal/secrets via shell env vars.
# Copy to .env.production, fill in, then before any `kamal` command:
#   set -a && source .env.production && set +a

# GitHub Personal Access Token (classic) with read:packages + write:packages,
# used to push/pull the app image to ghcr.io.
KAMAL_REGISTRY_PASSWORD=

# postgresql://postgres:<POSTGRES_PASSWORD below>@image-text-coherence-db:5432/laion
# (image-text-coherence-db is the accessory's container name on the Docker
# network Kamal creates -- the app reaches it by that hostname, not by the
# droplet's public IP)
DATABASE_URL=

# Shared class password for the web app
APP_PASSWORD=

# Long random string used to sign the session cookie: openssl rand -base64 32
SESSION_SECRET=

# Postgres superuser password for the db accessory: openssl rand -base64 24
POSTGRES_PASSWORD=
