# Local development for Docker Compose, `cd web && pnpm dev`, and pipeline/.
# Copy to .env and fill in: `cp .env.example .env`
#
# Production deploy uses .env.production instead (see DEPLOY.md).

# Shared class password for the web app
APP_PASSWORD=changeme

# Long random string used to sign the session cookie, e.g.: openssl rand -base64 32
SESSION_SECRET=generate-a-long-random-string

# Host processes (pipeline, `pnpm dev`, db/push_to_remote.sh). Docker Compose
# does not use this value; the web container gets hostname `db` from
# docker-compose.yml.
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/image-text-coherence

# Hugging Face access token with access accepted for
# https://huggingface.co/datasets/laion/relaion2B-en-research-safe
HF_TOKEN=hf_xxx

# How many images you want seeded into the database
TARGET_IMAGE_COUNT=250000
