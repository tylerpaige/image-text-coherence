# Kamal reads this file itself (via dotenv) on every `kamal` command -- it
# is NOT sourced by your shell. Each line just tells Kamal which shell env
# var to pull the real value from, so this file is safe to commit: it holds
# no actual secrets, only references.
#
# Before running any `kamal` command, export the real values, e.g.:
#   set -a && source .env.production && set +a
# (see .env.production.example and DEPLOY.md)

KAMAL_REGISTRY_PASSWORD=$KAMAL_REGISTRY_PASSWORD
DATABASE_URL=$DATABASE_URL
APP_PASSWORD=$APP_PASSWORD
SESSION_SECRET=$SESSION_SECRET
POSTGRES_PASSWORD=$POSTGRES_PASSWORD
