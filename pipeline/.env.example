# Hugging Face access token with access accepted for
# https://huggingface.co/datasets/laion/relaion2B-en-research-safe
HF_TOKEN=hf_xxx

# Local Postgres instance (see db/schema.sql), e.g. via:
#   docker run --name laion-pg -e POSTGRES_PASSWORD=postgres -p 5432:5432 -d pgvector/pgvector:pg16
LOCAL_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/laion

# How many images you want seeded into the database
TARGET_IMAGE_COUNT=250000
