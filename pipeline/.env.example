# Hugging Face access token with access accepted for
# https://huggingface.co/datasets/laion/relaion2B-en-research-safe
HF_TOKEN=hf_xxx

# Local Postgres from docker-compose.yml (host port 5433; schema applied on first boot).
LOCAL_DATABASE_URL=postgresql://postgres:postgres@localhost:5433/laion

# How many images you want seeded into the database
TARGET_IMAGE_COUNT=250000
